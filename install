#!/usr/bin/env bash
# ./install git|gh|both — link the wrappers, and gh-identity, into
# ~/.local/bin (or $GH_IDENTITY_BIN). Never replaces a file that is not
# already one of our links.
GID_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
. "$GID_HOME/lib/identity.sh"
. "$GID_HOME/lib/links.sh"

targets="$(gid_targets "${1:-}")" || exit 2
bin="$(gid_bin_dir)"
mkdir -p "$bin" || exit 1
status=0

for name in $targets gh-identity; do
  link="$bin/$name"
  if gid_owned "$link" "$name"; then
    echo "already linked: $link"
  elif [ -e "$link" ] || [ -L "$link" ]; then
    gid_err "$link exists and is not gh-identity's; leaving it alone"
    status=1
  else
    ln -s "$GID_HOME/bin/$name" "$link" && echo "linked: $link"
  fi
done

hash -r
for name in $targets; do
  first="$(command -v "$name")"
  if [ -n "$first" ] && ! [ "$first" -ef "$GID_HOME/bin/$name" ]; then
    gid_err "$first comes first on PATH, so the $name wrapper will not be used; put $bin earlier"
  fi
done
exit "$status"
